<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:importantForAutofill="noExcludeDescendants"
    android:saveEnabled="false"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ha_settings"
            android:textSize="30sp"
            android:textColor="#FFFFFFFF" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ha_setup_help"
            android:textSize="16sp"
            android:textColor="#FFACB8C1" />
        <EditText
            android:id="@+id/haOrigin"
            style="@style/HaInput"
            android:hint="@string/ha_origin_hint"
            android:inputType="textUri"
            android:imeOptions="actionNext|flagNoPersonalizedLearning"
            android:maxLength="2048" />
        <EditText
            android:id="@+id/haToken"
            style="@style/HaInput"
            android:hint="@string/ha_token_hint"
            android:inputType="textPassword"
            android:imeOptions="actionDone|flagNoPersonalizedLearning"
            android:maxLength="8192" />
        <TextView
            android:id="@+id/haStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/haSave"
            style="@style/SettingsRow"
            android:layout_marginTop="16dp"
            android:text="@string/ha_save_direct" />
        <TextView
            android:id="@+id/haBackend"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/ha_use_backend" />
        <TextView
            android:id="@+id/haForget"
            style="@style/SettingsRow"
            android:layout_marginTop="8dp"
            android:text="@string/ha_forget" />
    </LinearLayout>
</ScrollView>
