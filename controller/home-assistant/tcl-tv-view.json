{
  "title": "TCL TV",
  "path": "tcl-tv",
  "icon": "mdi:television",
  "type": "panel",
  "cards": [
    {
      "type": "vertical-stack",
      "cards": [
        {
          "type": "button",
          "name": "Open TCL controls",
          "icon": "mdi:open-in-new",
          "icon_height": "28px",
          "tap_action": {
            "action": "url",
            "url_path": "https://tcl.nitarnhome.synology.me/"
          },
          "hold_action": {
            "action": "none"
          }
        },
        {
          "type": "custom:button-card",
          "name": "TCL TV Control",
          "show_icon": false,
          "show_state": false,
          "tap_action": {
            "action": "none"
          },
          "hold_action": {
            "action": "none"
          },
          "double_tap_action": {
            "action": "none"
          },
          "variables": {
            "frame_origins": [
              "https://nitarnhome.synology.me",
              "https://home.nitarnhome.synology.me"
            ]
          },
          "styles": {
            "card": [
              {
                "padding": "0"
              },
              {
                "cursor": "default"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"n\" \"portal\""
              },
              {
                "grid-template-columns": "minmax(0, 1fr)"
              },
              {
                "grid-template-rows": "min-content auto"
              }
            ],
            "name": [
              {
                "justify-self": "start"
              },
              {
                "padding": "16px"
              },
              {
                "font-size": "20px"
              }
            ],
            "custom_fields": {
              "portal": [
                {
                  "width": "100%"
                },
                {
                  "min-width": "0"
                },
                {
                  "white-space": "normal"
                },
                {
                  "text-align": "left"
                }
              ]
            }
          },
          "custom_fields": {
            "portal": "[[[ if (!variables.frame_origins.includes(window.location.origin)) return '<div id=\"tcl-embed-guidance\" role=\"status\" style=\"padding:0 16px 20px;line-height:1.6;overflow-wrap:anywhere\"><p>This Home Assistant address cannot display the secure TCL controller inline.</p><p>Tap <strong>Open TCL controls</strong> above to use all controls in a separate page.</p><p>For inline controls in the iPhone Companion app, edit this Home Assistant server under <strong>Settings &gt; Companion app</strong> and use <strong>https://nitarnhome.synology.me</strong> or <strong>https://home.nitarnhome.synology.me</strong> for the Internal URL. Both Home Assistant and the TCL address must be reachable from the phone.</p></div>'; return '<iframe id=\"tcl-control-frame\" title=\"TCL TV controls\" src=\"https://tcl.nitarnhome.synology.me/\" sandbox=\"allow-forms allow-popups allow-pointer-lock allow-same-origin allow-scripts allow-modals allow-downloads\" allow=\"fullscreen\" style=\"display:block;width:100%;height:calc(100vh - 240px);height:calc(100dvh - 240px);min-height:360px;border:0\"></iframe>'; ]]]"
          }
        }
      ]
    }
  ]
}
